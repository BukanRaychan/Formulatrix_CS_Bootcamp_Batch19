classDiagram
    namespace UI {
        class ConsoleRenderer {
            -Board _board
            -string _eventMessage
            +GameController GameController
            ConsoleRenderer()
            +Render() void
            +MoveEvent(object? o, MoveEventArgs e) void
        }
    }

    namespace DTOs {
        class GameResponseDto {
            +bool Success
            +Player CurrentPlayer
            +Board Board 
        }

        class CreateGameDto {
            +string PlayerOneName
            +string PlayerTwoName
            +ConsoleColor PlayerOnePreferenceColor
            +ConsoleColor PlayerTwoPreferenceColor
            +BoardSize Size
        }
    }

    namespace Controllers {
        class GameController {
            -IGameService _gameService            
            +List~Player~ Player
            +event EventHandler~MoveEventArgs~? MoveMade
            +event EventHandler~GameEndedEventArgs~? GameEnded
            +Player CurrentPlayer
            +Start(CreateGameDto dto) GameResponseDto
            +Move(int fromX, int fromY, int toX, int toY) GameResponseDto
            -GetOpponent() Player
            -EndGame(Player winner, string reason) void
        }
    }
    
    namespace Services {
        class IGameService {
            <<interface>>
            +GetPieceAt(int x, int y) Piece?
            +TryMove(Piece piece, int toX, int toY, out bool crowned, out bool captured, out bool hasMoreCapture) bool
            +AllPieces() IEnumerable~Piece~
            +GetLegalMoves(Player player) IEnumerable~LegalMove~
            +GetLegalMoves(Piece piece) IEnumerable~LegalMove~
            +HasAnyMoves(Player player) bool
        }
        
        class GameService {
            -Board _board
            +GameService(CreateGameDto dto)
            +GetPieceAt(int x, int y) Piece?
            +TryMove(Piece piece, int toX, int toY, out bool crowned, out bool captured, out bool hasMoreCapture) bool
            +GetLegalMoves(Player player) IEnumerable~LegalMove~
            +GetLegalMoves(Piece piece) IEnumerable~LegalMove~
            +HasAnyMoves(Player player) bool
            +HasCaptureMoves(Player player) bool
            +AllPieces() IEnumerable~Piece~
            -PerformMove(Piece piece, int toX, int toY, bool capture, out bool crowned, out bool hasMoreCapture) void
            -IsInside(int x, int y) bool
        }
    }
    
    namespace Models {
        class Board {
            +Dictionary#lt;#40;int, int#41;, Piece?#gt; Grid 
            +BoardSize Size
            
            +Board(BoardSize Size)
        }
        class Piece {
            +PieceType PieceType
            +ConsoleColor Color
            +Player Player
        }

        class Player {
            +string Name
            +bool IsPlayerOne    
        }
    }

    namespace Events {
        class MoveEventArgs {
            +Player Player
            +#40;int X, int Y#41; From
            +#40;int X, int Y#41; To
            +Piece Piece
            +bool Crowned
        }

        class GameEndedEventArgs {
            +Player Winner
            +string Reason
        }
    }

    namespace Enums {
        class ConsoleColor {
            <<enumeration>>
        }

        class BoardSize {
            <<enumeration>>
            Small
            Standard
            Large
            VeryLarge
        }

        class PieceType {
            <<enumeration>>
            Man
            King
        }
    }

    ConsoleRenderer --> GameController : calls 
    GameController --> IGameService : uses
    GameController --> MoveEventArgs : uses
    GameController --> GameEndedEventArgs : uses
    GameController ..> GameResponseDto: depends on
    GameController ..> CreateGameDto: depends on
    GameService ..|> IGameService: implements
    GameService ..> CreateGameDto: depends on
    GameService --> Board : uses
    Board *-- "0..*" Piece: has
    Piece --> Player: belong to